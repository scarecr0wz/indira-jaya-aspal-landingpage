---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site, whatsappUrl } from '../data/site';
import heroImage from '../assets/images/hero-asphalt.png';
import parkingImage from '../assets/images/project-parking.png';
import roadImage from '../assets/images/project-road.png';
import detailImage from '../assets/images/project-detail.png';
import logoImage from '../assets/images/indira-aspal.png';
import serviceRoadImage from '../assets/images/service-road-v1.png';
import serviceResidentialImage from '../assets/images/service-residential-v1.png';
import serviceCommercialImage from '../assets/images/service-commercial-v1.png';
import serviceIndustrialImage from '../assets/images/service-industrial-v1.png';
import servicePavingImage from '../assets/images/service-paving-v1.png';

const projects = [
  { image: parkingImage, title: 'Pemadatan area parkir', category: 'Area Komersial', alt: 'Ilustrasi alat berat memadatkan aspal baru di area parkir' },
  { image: roadImage, title: 'Pelapisan jalan lingkungan', category: 'Jalan Lingkungan', alt: 'Ilustrasi tim mengaspal jalan lingkungan dengan mesin paver' },
  { image: detailImage, title: 'Finishing tepi jalan', category: 'Pekerjaan Detail', alt: 'Ilustrasi pekerja merapikan tepi permukaan aspal baru' },
];

const serviceImages = [
  serviceRoadImage,
  serviceResidentialImage,
  serviceCommercialImage,
  serviceIndustrialImage,
  servicePavingImage,
];
const serviceSlides = site.services.map((service, index) => ({
  ...service,
  image: serviceImages[index],
  alt: `${service.title} oleh Indira Jaya Aspal`,
}));

const serviceBenefits = [
  'Harga per m² jelas & transparan',
  'Material Hotmix Berkualitas (AC-WC, AC-BC)',
  'Pekerjaan kuat, rapi, cepat & bergaransi',
  'Gratis survei & pengukuran lokasi',
  'Berpengalaman dan terpercaya',
];
---

<BaseLayout>
  <Header />
  <main id="main-content">
    <section class="hero" id="beranda">
      <Image class="hero__image" src={heroImage} alt="Ilustrasi tim profesional mengerjakan pengaspalan jalan dengan alat berat" widths={[768, 1280, 1920, 2400]} sizes="100vw" loading="eager" fetchpriority="high" quality={85} />
      <div class="hero__veil"></div>
      <div class="container hero__grid">
        <div class="hero__content">
          <h1>Jalan lebih kuat.<br /><em>Pekerjaan lebih tepat.</em></h1>
          <p class="hero__lead">Layanan pengaspalan hotmix untuk jalan lingkungan, area usaha, halaman, dan kebutuhan perbaikan permukaan.</p>
          <div class="hero__actions">
            <a class="button" href={whatsappUrl} target="_blank" rel="noreferrer">Konsultasi via WhatsApp <span aria-hidden="true">↗</span></a>
            <a class="text-link text-link--light" href="#layanan">Lihat layanan <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <!-- Ganti blok ini dengan elemen <video> atau embed ketika aset video tersedia. -->
        <div class="hero__video" aria-label="Placeholder video profil proyek">
          <span class="hero__play" aria-hidden="true"></span>
          <p>Video profil proyek</p>
          <small>Placeholder video</small>
        </div>
      </div>
    </section>

    <section class="section services" id="layanan">
      <div class="container">
        <div class="section-heading split-heading">
          <div><h2>Layanan Kami</h2></div>
          <p>Kami membantu menyiapkan solusi pengerjaan sesuai kondisi area dan kebutuhan penggunaannya.</p>
        </div>
        <div class="service-carousel" data-service-carousel aria-roledescription="carousel" aria-label="Daftar layanan Indira Jaya Aspal">
          <div class="service-carousel__frame">
            <div class="service-carousel__viewport">
              <div class="service-carousel__track">
                {serviceSlides.map((service, index) => (
                  <article
                    class:list={['service-slide', { 'is-active': index === 0 }]}
                    data-service-slide
                    aria-hidden={index === 0 ? 'false' : 'true'}
                    aria-label={service.title}
                    aria-roledescription="slide"
                  >
                    <Image
                      class="service-slide__image"
                      src={service.image}
                      alt={service.alt}
                      widths={[640, 960, 1280, 1600]}
                      sizes="(max-width: 800px) calc(100vw - 2rem), 1200px"
                      loading={index === 0 ? 'eager' : 'lazy'}
                      quality={85}
                    />
                  </article>
                ))}
              </div>
            </div>
            <button class="service-carousel__arrow service-carousel__arrow--prev" type="button" data-service-prev aria-label="Layanan sebelumnya">←</button>
            <button class="service-carousel__arrow service-carousel__arrow--next" type="button" data-service-next aria-label="Layanan berikutnya">→</button>
          </div>

          <div class="service-carousel__captions">
            {serviceSlides.map((service, index) => (
              <div
                class:list={['service-slide__caption', { 'is-active': index === 0 }]}
                data-service-caption
                aria-hidden={index === 0 ? 'false' : 'true'}
              >
                <h3>{service.title}</h3>
              </div>
            ))}
          </div>

          <ul class="service-benefits">
            {serviceBenefits.map((benefit) => (
              <li><span aria-hidden="true">✓</span>{benefit}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="section specification" id="spesifikasi">
      <div class="container editorial-grid">
        <div class="editorial-intro">
          <h2>Spesifikasi Pekerjaan</h2>
        </div>
        <div class="editorial-content">
          <p class="editorial-lead">Spesifikasi pengaspalan tidak ditentukan hanya dari luas area. Kondisi permukaan, beban kendaraan, akses alat, dan kebutuhan penggunaan ikut menjadi pertimbangan sebelum pekerjaan dimulai.</p>
          {site.specifications.map((item) => (
            <article class="editorial-item">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section about" id="tentang">
      <div class="container about-grid">
        <div class="about-visual">
          <Image src={detailImage} alt="Ilustrasi detail pengerjaan dan perataan aspal" widths={[360, 480, 768, 1000]} sizes="(max-width: 800px) calc(100vw - 2rem), 50vw" loading="lazy" />
          <div class="about-stamp"><Image class="about-stamp__logo" src={logoImage} alt="" width={64} height={64} /><strong>{site.name}</strong><span>Spesialis Aspal Hotmix dan Jalan</span></div>
        </div>
        <div class="about-copy">
          <h2>Tentang Kami</h2>
          <p>Indira Jaya Aspal hadir sebagai mitra pengerjaan jalan dan area beraspal. Setiap kebutuhan dimulai dengan memahami kondisi lokasi, penggunaan area, dan hasil yang diharapkan.</p>
          <a class="text-link" href={whatsappUrl} target="_blank" rel="noreferrer">Diskusikan kebutuhan Anda <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="section reasons" id="alasan">
      <div class="container editorial-grid">
        <div class="editorial-intro">
          <h2>Mengapa Memilih Kami</h2>
        </div>
        <div class="editorial-content">
          <p class="editorial-lead">Kami mengutamakan komunikasi yang jelas dan solusi yang relevan dengan kebutuhan lokasi. Tujuannya bukan membuat proses terasa rumit, tetapi membantu pemilik area mengambil keputusan dengan informasi yang cukup.</p>
          {site.reasons.map((reason) => (
            <article class="editorial-item">
              <h3>{reason.title}</h3>
              <p>{reason.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section projects" id="proyek">
      <div class="container">
        <div class="section-heading split-heading">
          <div><h2>Dokumentasi Kami</h2></div>
        </div>
        <div class="project-grid">
          {projects.map((project, index) => (
            <article class:list={['project-card', { 'project-card--wide': index === 0 }]}>
              <Image src={project.image} alt={project.alt} widths={[540, 800, 1200]} sizes={index === 0 ? '(max-width: 800px) 100vw, 60vw' : '(max-width: 800px) 100vw, 38vw'} loading="lazy" />
              <div class="project-card__caption"><div><span>{project.category}</span><h3>{project.title}</h3></div></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-section" id="kontak">
      <div class="container cta-grid">
        <div>
          <h2>Konsultasikan dengan Kami<br /><em>Segala Keperluan Anda</em></h2>
        </div>
        <div class="cta-copy">
          <p>Kirimkan informasi lokasi dan kebutuhan pekerjaan Anda. Kami akan membantu mengarahkan langkah selanjutnya.</p>
          <a class="button button--light" href={whatsappUrl} target="_blank" rel="noreferrer">Chat WhatsApp Sekarang <span aria-hidden="true">↗</span></a>
          <small>Area layanan: {site.serviceArea}</small>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppButton />
</BaseLayout>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-service-carousel]');

  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-service-slide]'));
    const captions = Array.from(carousel.querySelectorAll<HTMLElement>('[data-service-caption]'));
    const previousButton = carousel.querySelector<HTMLButtonElement>('[data-service-prev]');
    const nextButton = carousel.querySelector<HTMLButtonElement>('[data-service-next]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let currentIndex = 0;
    let autoplay: number | undefined;

    const showSlide = (nextIndex: number) => {
      currentIndex = (nextIndex + slides.length) % slides.length;

      slides.forEach((slide, index) => {
        const active = index === currentIndex;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
      });

      captions.forEach((caption, index) => {
        const active = index === currentIndex;
        caption.classList.toggle('is-active', active);
        caption.setAttribute('aria-hidden', String(!active));
      });

    };

    const stopAutoplay = () => {
      if (autoplay !== undefined) window.clearInterval(autoplay);
      autoplay = undefined;
    };

    const startAutoplay = () => {
      stopAutoplay();
      if (!reduceMotion && !document.hidden) {
        autoplay = window.setInterval(() => showSlide(currentIndex + 1), 5000);
      }
    };

    previousButton?.addEventListener('click', () => {
      showSlide(currentIndex - 1);
      startAutoplay();
    });
    nextButton?.addEventListener('click', () => {
      showSlide(currentIndex + 1);
      startAutoplay();
    });
    carousel.addEventListener('mouseenter', stopAutoplay);
    carousel.addEventListener('mouseleave', startAutoplay);
    carousel.addEventListener('focusin', stopAutoplay);
    carousel.addEventListener('focusout', (event) => {
      if (!carousel.contains(event.relatedTarget as Node | null)) startAutoplay();
    });
    document.addEventListener('visibilitychange', () => document.hidden ? stopAutoplay() : startAutoplay());

    startAutoplay();
  }
</script>
