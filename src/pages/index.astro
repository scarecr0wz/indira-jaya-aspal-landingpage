---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site, whatsappUrl } from '../data/site';
import heroImage from '../assets/images/hero-asphalt.png';
import parkingImage from '../assets/images/project-parking.png';
import roadImage from '../assets/images/project-road.png';
import detailImage from '../assets/images/project-detail.png';
import logoImage from '../assets/images/indira-aspal.png';

const projects = [
  { image: parkingImage, title: 'Pemadatan area parkir', category: 'Area Komersial', alt: 'Ilustrasi alat berat memadatkan aspal baru di area parkir' },
  { image: roadImage, title: 'Pelapisan jalan lingkungan', category: 'Jalan Lingkungan', alt: 'Ilustrasi tim mengaspal jalan lingkungan dengan mesin paver' },
  { image: detailImage, title: 'Finishing tepi jalan', category: 'Pekerjaan Detail', alt: 'Ilustrasi pekerja merapikan tepi permukaan aspal baru' },
];
---

<BaseLayout image={heroImage.src}>
  <Header />
  <main id="main-content">
    <section class="hero" id="beranda">
      <Image class="hero__image" src={heroImage} alt="Ilustrasi tim profesional mengerjakan pengaspalan jalan dengan alat berat" widths={[768, 1280, 1920, 2400]} sizes="100vw" loading="eager" fetchpriority="high" quality={85} />
      <div class="hero__veil"></div>
      <div class="container hero__grid">
        <div class="hero__content">
          <h1>Jalan lebih kuat.<br /><em>Pekerjaan lebih tepat.</em></h1>
          <p class="hero__lead">Layanan pengaspalan hotmix untuk jalan lingkungan, area usaha, halaman, dan kebutuhan perbaikan permukaan.</p>
          <div class="hero__actions">
            <a class="button" href={whatsappUrl} target="_blank" rel="noreferrer">Konsultasi via WhatsApp <span aria-hidden="true">↗</span></a>
            <a class="text-link text-link--light" href="#layanan">Lihat layanan <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <!-- Ganti blok ini dengan elemen <video> atau embed ketika aset video tersedia. -->
        <div class="hero__video" aria-label="Placeholder video profil proyek">
          <span class="hero__play" aria-hidden="true"></span>
          <p>Video profil proyek</p>
          <small>Placeholder video</small>
        </div>
      </div>
    </section>

    <section class="section services" id="layanan">
      <div class="container">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Layanan Kami</p><h2>Dari persiapan hingga<br />lapisan akhir.</h2></div>
          <p>Kami membantu menyiapkan solusi pengerjaan sesuai kondisi area dan kebutuhan penggunaannya.</p>
        </div>
        <div class="service-grid">
          {site.services.map((service) => (
            <article class="service-item">
              <span class="service-item__number">{service.number}</span>
              <div>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section specification" id="spesifikasi">
      <div class="container editorial-grid">
        <div class="editorial-intro">
          <p class="eyebrow">Spesifikasi Pekerjaan</p>
          <h2>Disiapkan sesuai fungsi dan kondisi area.</h2>
        </div>
        <div class="editorial-content">
          <p class="editorial-lead">Spesifikasi pengaspalan tidak ditentukan hanya dari luas area. Kondisi permukaan, beban kendaraan, akses alat, dan kebutuhan penggunaan ikut menjadi pertimbangan sebelum pekerjaan dimulai.</p>
          {site.specifications.map((item) => (
            <article class="editorial-item">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section about" id="tentang">
      <div class="container about-grid">
        <div class="about-visual">
          <Image src={detailImage} alt="Ilustrasi detail pengerjaan dan perataan aspal" widths={[360, 480, 768, 1000]} sizes="(max-width: 800px) calc(100vw - 2rem), 50vw" loading="lazy" />
          <div class="about-stamp"><Image class="about-stamp__logo" src={logoImage} alt="" width={64} height={64} /><strong>{site.name}</strong><span>Spesialis Aspal Hotmix dan Jalan</span></div>
        </div>
        <div class="about-copy">
          <p class="eyebrow">Tentang Kami</p>
          <h2>Pekerjaan rapi dimulai dari perencanaan yang jelas.</h2>
          <p>Indira Jaya Aspal hadir sebagai mitra pengerjaan jalan dan area beraspal. Setiap kebutuhan dimulai dengan memahami kondisi lokasi, penggunaan area, dan hasil yang diharapkan.</p>
          <a class="text-link" href={whatsappUrl} target="_blank" rel="noreferrer">Diskusikan kebutuhan Anda <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="section reasons" id="alasan">
      <div class="container editorial-grid">
        <div class="editorial-intro">
          <p class="eyebrow">Mengapa Memilih Kami</p>
          <h2>Pendekatan sederhana, pekerjaan lebih terarah.</h2>
        </div>
        <div class="editorial-content">
          <p class="editorial-lead">Kami mengutamakan komunikasi yang jelas dan solusi yang relevan dengan kebutuhan lokasi. Tujuannya bukan membuat proses terasa rumit, tetapi membantu pemilik area mengambil keputusan dengan informasi yang cukup.</p>
          {site.reasons.map((reason) => (
            <article class="editorial-item">
              <h3>{reason.title}</h3>
              <p>{reason.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section projects" id="proyek">
      <div class="container">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Galeri Pekerjaan</p><h2>Gambaran hasil<br />yang kami kerjakan.</h2></div>
          <p class="template-note">Foto berikut merupakan ilustrasi AI untuk kebutuhan template dan akan diganti dengan dokumentasi proyek asli.</p>
        </div>
        <div class="project-grid">
          {projects.map((project, index) => (
            <article class:list={['project-card', { 'project-card--wide': index === 0 }]}>
              <Image src={project.image} alt={project.alt} widths={[540, 800, 1200]} sizes={index === 0 ? '(max-width: 800px) 100vw, 60vw' : '(max-width: 800px) 100vw, 38vw'} loading="lazy" />
              <div class="project-card__caption"><div><span>{project.category}</span><h3>{project.title}</h3></div><strong>0{index + 1}</strong></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-section" id="kontak">
      <div class="container cta-grid">
        <div>
          <p class="eyebrow eyebrow--light">Mulai Konsultasi</p>
          <h2>Punya lokasi yang perlu<br /><em>diaspal atau diperbaiki?</em></h2>
        </div>
        <div class="cta-copy">
          <p>Kirimkan informasi lokasi dan kebutuhan pekerjaan Anda. Kami akan membantu mengarahkan langkah selanjutnya.</p>
          <a class="button button--light" href={whatsappUrl} target="_blank" rel="noreferrer">Chat WhatsApp Sekarang <span aria-hidden="true">↗</span></a>
          <small>Area layanan: {site.serviceArea}</small>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppButton />
</BaseLayout>
