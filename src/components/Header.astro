---
import Logo from './Logo.astro';
import ContactIcon from './ContactIcon.astro';
import SocialIcon from './SocialIcon.astro';
import { site, whatsappUrl, phoneUrl, emailUrl } from '../data/site';
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <Logo light />
    <nav class="desktop-nav" aria-label="Navigasi utama">
      <a href="#beranda">Beranda</a>
      <a href="#layanan">Layanan</a>
      <a href="#tentang">Tentang</a>
      <a href="#proyek">Proyek</a>
    </nav>
    <a class="button button--small header-cta" href={whatsappUrl} target="_blank" rel="noreferrer">Konsultasi Gratis</a>
    <button class="menu-button" type="button" aria-label="Buka menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
      <span></span><span></span>
    </button>
  </div>
  <nav class="mobile-nav" id="mobile-menu" aria-label="Navigasi mobile" data-mobile-menu>
    <div class="mobile-nav__links">
      <a href="#beranda">Beranda</a>
      <a href="#layanan">Layanan</a>
      <a href="#tentang">Tentang</a>
      <a href="#proyek">Proyek</a>
      <a href="#kontak">Kontak</a>
    </div>
    <div class="mobile-nav__contact">
      <p>Hubungi Kami</p>
      <a href={whatsappUrl} target="_blank" rel="noreferrer"><ContactIcon name="whatsapp" /><span><small>WhatsApp</small>{site.phoneDisplay}</span></a>
      <a href={phoneUrl}><ContactIcon name="phone" /><span><small>Telepon</small>{site.phoneDisplay}</span></a>
      <a class="contact-email" href={emailUrl}><span aria-hidden="true">@</span><span><small>Email</small>{site.email}</span></a>
      <div class="mobile-nav__social" aria-label="Media sosial (segera hadir)">
        <span class=social-icon role=img aria-label=Instagram title=Instagram><SocialIcon name=instagram /></span>
        <span class=social-icon role=img aria-label=Facebook title=Facebook><SocialIcon name=facebook /></span>
        <span class=social-icon role=img aria-label=TikTok title=TikTok><SocialIcon name=tiktok /></span>
      </div>
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector('[data-menu-button]');
  const menu = document.querySelector('[data-mobile-menu]');
  button?.addEventListener('click', () => {
    const isOpen = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!isOpen));
    button.setAttribute('aria-label', isOpen ? 'Buka menu' : 'Tutup menu');
    menu?.classList.toggle('is-open', !isOpen);
  });
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    button?.setAttribute('aria-expanded', 'false');
    menu.classList.remove('is-open');
  }));
</script>
