---
import { whatsappUrl } from '../data/site';
---

<a class="whatsapp-float" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="Konsultasi melalui WhatsApp" data-whatsapp-float>
  <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3a12.8 12.8 0 0 0-11 19.3L3.2 29l6.9-1.8A12.9 12.9 0 1 0 16 3Zm0 23.3c-2 0-3.9-.5-5.5-1.5l-.4-.2-4.1 1.1 1.1-4-.3-.4A10.3 10.3 0 1 1 16 26.3Zm5.7-7.7c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.4 8.4 0 0 1-4.2-3.7c-.3-.5.3-.5.9-1.7.1-.2.1-.4 0-.6l-1-2.5c-.3-.6-.6-.5-.8-.5h-.6c-.2 0-.6.1-.9.4-.3.4-1.2 1.2-1.2 2.9 0 1.7 1.2 3.3 1.4 3.6.2.2 2.4 3.7 5.9 5.2 2.2.9 3.1 1 4.2.8.7-.1 1.9-.8 2.2-1.5.3-.7.3-1.3.2-1.5-.2-.2-.4-.3-.7-.4Z"/></svg>
  <span>Konsultasi</span>
</a>

<script>
  const floatingButton = document.querySelector('[data-whatsapp-float]');
  const updateVisibility = () => floatingButton?.classList.toggle('is-visible', window.scrollY > 280);
  updateVisibility();
  window.addEventListener('scroll', updateVisibility, { passive: true });
</script>
