---
interface Props {
  name: 'instagram' | 'facebook' | 'tiktok';
}

const { name } = Astro.props;
---

{name === 'instagram' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4" />
    <circle cx="17.4" cy="6.6" r=".8" fill="currentColor" stroke="none" />
  </svg>
)}

{name === 'facebook' && (
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M13.7 21v-8h2.8l.42-3.16H13.7V7.82c0-.91.27-1.54 1.62-1.54H17V3.46a23 23 0 0 0-2.46-.13c-2.44 0-4.11 1.47-4.11 4.18v2.33H7.67V13h2.76v8h3.27Z" />
  </svg>
)}

{name === 'tiktok' && (
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M15.55 3c.2 1.72 1.16 2.75 2.85 3.08v2.9a7.68 7.68 0 0 1-2.82-.65v5.48a6.5 6.5 0 0 1-.78 3.48 5.85 5.85 0 0 1-4.55 2.7 5.61 5.61 0 0 1-3.14-.71A5.9 5.9 0 0 1 4.2 15.6a5.96 5.96 0 0 1 6.82-7.34v3.04a2.93 2.93 0 0 0-3.75 2.82 2.85 2.85 0 0 0 5.27 1.57c.2-.4.3-.84.3-1.28V3h2.71Z" />
  </svg>
)}
