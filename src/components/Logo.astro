---
interface Props {
  light?: boolean;
}

const { light = false } = Astro.props;
---

<a class:list={['logo', { 'logo--light': light }]} href="#beranda" aria-label="Indira Jaya Aspal — kembali ke beranda">
  <span class="logo__mark" aria-hidden="true">
    <svg viewBox="0 0 42 42" role="img">
      <path d="M11 35 18 7h6l7 28h-7l-1.4-7h-3.2L18 35h-7Z" fill="currentColor" />
      <path d="M20.2 21.8h1.6L21 17l-.8 4.8Z" fill="var(--logo-cutout)" />
      <path d="M20 30h2v5h-2z" fill="#f3c844" />
    </svg>
  </span>
  <span class="logo__text"><strong>Indira Jaya</strong><small>Aspal & Konstruksi Jalan</small></span>
</a>

<style>
  .logo { --logo-cutout: var(--red); display: inline-flex; align-items: center; gap: .68rem; color: var(--ink); text-decoration: none; }
  .logo--light { color: white; }
  .logo__mark { display: grid; width: 2.65rem; height: 2.65rem; place-items: center; border-radius: .65rem; color: white; background: var(--red); overflow: hidden; }
  .logo__mark svg { width: 2.35rem; color: white; }
  .logo__text { display: grid; line-height: 1; }
  .logo__text strong { font-size: .95rem; letter-spacing: -.01em; text-transform: uppercase; }
  .logo__text small { margin-top: .32rem; color: var(--muted); font-size: .57rem; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }
  .logo--light .logo__text small { color: #aeb1b5; }
</style>
